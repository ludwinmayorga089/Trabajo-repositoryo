# Base de datos
MYSQL_DATABASE=fastapi_db
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=fastapi_user
MYSQL_PASSWORD=fastapi_pass

# Backend
DATABASE_URL=mysql+pymysql://root:root@db:3306/fastapi_db
PYTHONUNBUFFERED=1

# Frontend
NODE_ENV=development
CHOKIDAR_USEPOLLING=true

# Puertos
BACKEND_PORT=8001
FRONTEND_PORT=4200
MYSQL_PORT=3307